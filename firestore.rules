rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200;
      allow read, update, delete: if false;
    }

    // One registration per account: the document id is the signed-in uid, so a
    // doctor cannot create duplicates and can read back their own submission.
    match /doctors/{docId} {
      allow create: if request.auth != null
        && docId == request.auth.uid

        // A doctor gets in by confirming an SMS code or through Google, and
        // whichever identifier the token carries has to be the one stored:
        // the other is typed in and merely claimed.
        && (
             (request.auth.token.phone_number is string
               && request.resource.data.phone == request.auth.token.phone_number)
             ||
             (request.auth.token.email_verified == true
               && request.resource.data.email == request.auth.token.email)
           )

        && request.resource.data.keys().hasAll([
             'name', 'phone', 'specialty', 'country', 'city', 'state', 'channels',
             'verification_status', 'source', 'consent_at', 'createdAt'
           ])
        && request.resource.data.uid == request.auth.uid

        // nobody gets to mark themselves approved from the client
        && request.resource.data.verification_status == 'pending'
        && request.resource.data.source == 'website'

        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 7
        && request.resource.data.phone.size() < 20
        && request.resource.data.city is string
        && request.resource.data.city.size() < 100
        && request.resource.data.state is string
        && request.resource.data.state.size() < 100;

      // A doctor may read back their own record — this is what tells someone
      // who forgot whether they registered that we already have their details.
      allow read: if request.auth != null && docId == request.auth.uid;

      // Status changes and corrections go through our team, not the client.
      allow update, delete: if false;
    }
  }
}
