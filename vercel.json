{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://charak-admin.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://charak-admin.vercel.app/admin/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
